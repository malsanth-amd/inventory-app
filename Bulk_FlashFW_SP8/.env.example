# Copy to .env and fill in real values. Never commit the real .env file.

# -- Entra ID (Azure AD) app registration - see README.md for how to create one --
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://your-server-host/auth/callback

# -- Session cookie signing key - generate with:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# -- Local-only testing (see README.md). NEVER set this in a real deployment. --
DEV_BYPASS_AUTH=0
BIND_HOST=127.0.0.1
