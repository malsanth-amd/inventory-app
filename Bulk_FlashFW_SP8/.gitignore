# Downloaded firmware binaries (BIOS/BMC/FPGA images) - large, proprietary
# AMD firmware fetched by the refresh job at runtime. Never commit these.
flashtools/bin/firmware/

# Per-system fleet flash logs - runtime output, not source (the repo root's
# *.log already covers this too; kept here for clarity on this subtree).
flashtools/fleet_logs/*.log

# recipe.yaml is generated/refreshed by the app itself (see "Refresh firmware
# from BKC page") and contains machine-local file:// paths for BMC/FPGA -
# never commit a checked-out copy; run a refresh once after deploying.
flashtools/recipe.yaml
flashtools/recipe.yaml.bak

# Local dev-only Claude Code preview config, not part of the app.
.claude/
