# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Folder where the SQLite database lives. Can be a local path, a mapped drive
# or a UNC path; falls back to ./data if the drive/share is unavailable.
#   Windows mapped drive : C:\inventory
#   UNC path             : \\server\share\inventory
#   Local fallback       : ./data
INVENTORY_DATA_DIR=./data

# Network interface to listen on (0.0.0.0 = all interfaces, reachable on LAN)
HOST=0.0.0.0
PORT=8080

# Username of the superadmin who can manage credentials (add/remove admins,
# change passwords). Other admins have full inventory access but no Credentials tab.
SUPER_ADMIN_USERNAME=changeme

# Optional second superadmin for maintenance work. Leave EMPTY unless you need
# one: the server creates no such account on its own. If you do set a name here,
# create the account like any other admin (Credentials tab) and give it its own
# password. Earlier versions hardcoded an "FVDDR_Dev" account whose password was
# fixed in server.py and could not be rotated — if that account still exists in
# admins.json, delete it.
DEVELOPER_USERNAME=

# Admin accounts — up to 3. These are only used to bootstrap data/admins.json
# on first run; after that the hashed credentials in admins.json take over.
ADMIN_1_USERNAME=changeme
ADMIN_1_PASSWORD=changeme
ADMIN_2_USERNAME=
ADMIN_2_PASSWORD=
ADMIN_3_USERNAME=
ADMIN_3_PASSWORD=

# SMTP for loan reminders and return requests. Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Lab Inventory Manager
# Set to false for internal port-25 relays that don't require STARTTLS
SMTP_USE_TLS=true

# Comma-separated addresses CC'd on every reminder
REMINDER_CC=

# Address that receives inventory submission requests from users
ADMIN_EMAIL=
