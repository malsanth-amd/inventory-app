# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Folder where the SQLite database lives. Can be a local path, a mapped drive
# or a UNC path; falls back to ./data if the drive/share is unavailable.
#   Windows mapped drive : C:\inventory
#   UNC path             : \\server\share\inventory
#   Local fallback       : ./data
INVENTORY_DATA_DIR=./data

# Network interface to listen on (0.0.0.0 = all interfaces, reachable on LAN)
HOST=0.0.0.0
PORT=8080

# Username of the superadmin who can manage credentials (add/remove admins,
# change passwords). Other admins have full inventory access but no Credentials tab.
SUPER_ADMIN_USERNAME=changeme

# Optional second superadmin for maintenance work. Leave EMPTY unless you need
# one: the server creates no such account on its own. If you do set a name here,
# create the account like any other admin (Credentials tab) and give it its own
# password. Earlier versions hardcoded an "FVDDR_Dev" account whose password was
# fixed in server.py and could not be rotated — if that account still exists in
# admins.json, delete it.
DEVELOPER_USERNAME=

# Admin accounts — up to 3. These are only used to bootstrap data/admins.json
# on first run; after that the hashed credentials in admins.json take over.
ADMIN_1_USERNAME=changeme
ADMIN_1_PASSWORD=changeme
ADMIN_2_USERNAME=
ADMIN_2_PASSWORD=
ADMIN_3_USERNAME=
ADMIN_3_PASSWORD=

# SMTP for loan reminders and return requests. Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Lab Inventory Manager
# Set to false for internal port-25 relays that don't require STARTTLS
SMTP_USE_TLS=true

# Comma-separated addresses CC'd on every reminder
REMINDER_CC=

# Address that receives inventory submission requests from users
ADMIN_EMAIL=

# BMC login used by the CPU Decoder tab (and by ppin_sn.py on the command
# line) to read the CPU PPIN fuse off a SUT's BMC. The server holds these; they
# are never sent to the browser.
BMC_USER=root
BMC_PASSWORD=changeme
BMC_PORT=22

# Which systems the CPU Decoder may SSH to. Empty means any hostname — and the
# tab needs no login, so anyone who can reach this port can have the server try
# the credentials above against a host they name. Narrow it to your lab's
# naming, e.g.:
#   BMC_HOST_ALLOW=seagull-*,eagle-*
BMC_HOST_ALLOW=

# Nightly CPU audit scan — reads every system in this CSV once a day (default
# 00:30) using the BMC credentials above, and stamps each CPU it finds with
# where and when it was seen (the Audit column). One column, header "name",
# one hostname per row.
#
# This path is a dated export. When the lab's system list changes, overwrite
# this same file with the new export rather than pointing this at a new dated
# filename each time — the server only re-reads it at scan time, so there is
# nothing else to restart or reconfigure.
AUDIT_SYSTEMS_CSV=C:\inventory-app\fvddr-systems-2026-11-02_all.csv
AUDIT_SCAN_ENABLED=true
AUDIT_SCAN_HOUR=0
AUDIT_SCAN_MINUTE=30
# Pause between systems, in seconds, so ninety-odd back-to-back SSH sessions
# do not look like a sweep to anything watching the network.
AUDIT_SCAN_HOST_DELAY_SEC=1.5

# Nightly DIMM audit scan — same CSV, same Audit column, but for DIMMs: for
# each system it auto-grabs the OS IP (BMC Redfish first), SSHes into the OS
# with the OS_LOGIN_* credential cascade below, and runs a dmidecode-based
# DIMM read. A separate toggle and clock from the CPU scan above (defaults an
# hour later) so the two scans do not hit the same BMCs at once.
DIMM_SCAN_ENABLED=true
DIMM_SCAN_HOUR=1
DIMM_SCAN_MINUTE=30
DIMM_SCAN_HOST_DELAY_SEC=1.5
# Off by default: this is the only part of either scan that can log in to a
# SUT's own console (over the BMC's serial-over-LAN), which can bump whoever
# already has that console open. Turn on only after confirming Redfish-only
# discovery works against this fleet — see the DIMM scan panel's "run now"
# button to test by hand before relying on the nightly schedule.
DIMM_SOL_FALLBACK_ENABLED=false
# OS login(s) the DIMM scan tries, in order, against the SUT itself (not its
# BMC) — up to 3 numbered pairs, same pattern as the admin accounts above.
# Leave a slot's _USER blank to skip it. Required for the DIMM scan to log in
# at all; there is no hardcoded fallback.
OS_LOGIN_1_USER=
OS_LOGIN_1_PASSWORD=
OS_LOGIN_2_USER=
OS_LOGIN_2_PASSWORD=
OS_LOGIN_3_USER=
OS_LOGIN_3_PASSWORD=
